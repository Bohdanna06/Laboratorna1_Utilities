@page "/tenants/edit/{Id:int}"
@using Microsoft.AspNetCore.Components.Forms
@using Laboratorna5_Utilities.Models
@using Laboratorna5_Utilities.Services
@inject AppDbService DbService
@inject NavigationManager Navigation

<h3>Редагувати мешканця</h3>

@if (tenantModel == null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <EditForm Model="tenantModel" OnValidSubmit="Update">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Особовий рахунок:</label>
            <InputText @bind-Value="tenantModel.AccountNumber" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">ПІБ:</label>
            <InputText @bind-Value="tenantModel.FullName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Адреса:</label>
            <InputText @bind-Value="tenantModel.Address" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Кількість мешканців:</label>
            <InputNumber @bind-Value="tenantModel.OccupantsCount" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Площа (м²):</label>
            <InputNumber @bind-Value="tenantModel.Area" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Зберегти зміни</button>
        <a href="/tenants" class="btn btn-secondary">Скасувати</a>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Tenant? tenantModel;

    protected override async Task OnInitializedAsync()
    {
        tenantModel = await DbService.GetTenantByIdAsync(Id);
    }

    private async Task Update()
    {
        if (tenantModel != null)
        {
            await DbService.UpdateTenantAsync(tenantModel);
            Navigation.NavigateTo("/tenants");
        }
    }
}