@page "/services/edit/{Id:int}"
@using Microsoft.AspNetCore.Components.Forms
@using Laboratorna5_Utilities.Models
@using Laboratorna5_Utilities.Services
@inject AppDbService DbService
@inject NavigationManager Navigation

<h3>Редагування послуги</h3>

@if (serviceModel == null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <EditForm Model="serviceModel" OnValidSubmit="Update">
        <DataAnnotationsValidator />
        
        <div class="mb-3">
            <label class="form-label">Назва послуги:</label>
            <InputText @bind-Value="serviceModel.ServiceName" class="form-control" />
        </div>
        
        <div class="mb-3">
            <label class="form-label">Тариф за м²:</label>
            <InputNumber @bind-Value="serviceModel.RatePerSqMeter" class="form-control" />
        </div>
        
        <div class="mb-3">
            <label class="form-label">Тариф за особу:</label>
            <InputNumber @bind-Value="serviceModel.RatePerPerson" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Зберегти</button>
        <a href="/services" class="btn btn-secondary">Скасувати</a>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Laboratorna5_Utilities.Models.Service? serviceModel;

    protected override async Task OnInitializedAsync()
    {
        serviceModel = await DbService.GetServiceByIdAsync(Id);
    }

    private async Task Update()
    {
        if (serviceModel != null)
        {
            await DbService.UpdateServiceAsync(serviceModel);
            Navigation.NavigateTo("/services");
        }
    }
}