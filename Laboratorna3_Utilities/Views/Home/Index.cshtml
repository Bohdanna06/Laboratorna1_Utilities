@model IEnumerable<Laboratorna3_Utilities.Models.TenantServiceViewModel>

@{
    ViewData["Title"] = "Головна - Зводний звіт";
}

<div class="text-center my-4">
    <h1 class="display-5 fw-bold">Система обліку комунальних послуг</h1>
    <p class="text-muted">Зведена таблиця нарахувань</p>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Особовий рахунок</th>
                <th>ПІБ</th>
                <th>Адреса</th>
                <th>Мешканців</th>
                <th>Площа (м²)</th>
                <th>Послуга</th>
                <th>Тариф / м²</th>
                <th>Тариф / особу</th>
                <th>Нараховано (грн)</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Особовий_рахунок</td>
                        <td>@item.ПІБ</td>
                        <td>@item.Адреса</td>
                        <td>@item.Мешканців</td>
                        <td>@item.Площа_м2</td>
                        <td>@item.Послуга</td>
                        <td>@item.Тариф_за_м2.ToString("N2")</td>
                        <td>@item.Тариф_за_особу.ToString("N2")</td>
                        <td class="fw-bold text-success">@item.Нараховано_грн.ToString("N2") грн</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center text-muted">Записи про нарахування відсутні</td>
                </tr>
            }
        </tbody>
    </table>
</div>