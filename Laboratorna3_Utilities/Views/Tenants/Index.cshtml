@model IEnumerable<Laboratorna3_Utilities.Tenant>

@{
    ViewData["Title"] = "Управління мешканцями";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Управління мешканцями</h2>
    <a asp-action="Create" class="btn btn-success">+ Додати мешканця</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Особовий рахунок</th>
                <th>ПІБ</th>
                <th>Адреса</th>
                <th>Мешканців</th>
                <th>Площа (м²)</th>
                <th style="width: 180px;">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AccountNumber</td>
                    <td>@item.FullName</td>
                    <td>@item.Address</td>
                    <td>@item.OccupantsCount</td>
                    <td>@item.Area</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning">Редагувати</a>
                        <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger">Видалити</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>