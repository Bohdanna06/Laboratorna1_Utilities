@model Laboratorna3_Utilities.Tenant

@{
    ViewData["Title"] = "Видалення мешканця";
}

<h3>Ви впевнені, що хочете видалити цей запис?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.AccountNumber)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.AccountNumber)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.FullName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.FullName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Address)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Address)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        <button type="submit" class="btn btn-danger">Видалити</button>
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>