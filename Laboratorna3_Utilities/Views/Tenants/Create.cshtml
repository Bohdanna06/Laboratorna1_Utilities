@model Laboratorna3_Utilities.Tenant

@{
    ViewData["Title"] = "Додати мешканця";
}

<h2>Додати мешканця</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div class="mb-3">
                <label class="form-label">Особовий рахунок</label>
                <input asp-for="AccountNumber" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">ПІБ</label>
                <input asp-for="FullName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Адреса</label>
                <input asp-for="Address" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Кількість мешканців</label>
                <input asp-for="OccupantsCount" class="form-control" type="number" min="1" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Площа (м²)</label>
                <input asp-for="Area" class="form-control" type="number" step="0.01" min="0" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Підключені послуги:</label>
                @if (ViewBag.Services != null)
                {
                    foreach (var service in (List<Laboratorna3_Utilities.Service>)ViewBag.Services)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="selectedServices" value="@service.ID" id="service_@service.ID">
                            <label class="form-check-label" for="service_@service.ID">
                                @service.ServiceName
                            </label>
                        </div>
                    }
                }
            </div>
            <button type="submit" class="btn btn-primary">Зберегти</button>
            <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
        </form>
    </div>
</div>
